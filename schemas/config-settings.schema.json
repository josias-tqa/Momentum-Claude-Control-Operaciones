{
  "type": "object",
  "required": [
    "triageCriteria",
    "retention"
  ],
  "properties": {
    "triageCriteria": {
      "type": "string",
      "maxLength": 20000
    },
    "severityMatrix": {
      "type": "string",
      "maxLength": 8000
    },
    "retention": {
      "type": "object",
      "required": [],
      "properties": {
        "runsDays": {
          "type": "integer",
          "minimum": 0
        },
        "closedIncidentsDays": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "intervalMinutes": {
      "type": "integer",
      "minimum": 0
    },
    "pendingMaxMinutes": {
      "type": "integer",
      "minimum": 0
    },
    "timezone": {
      "type": "string",
      "maxLength": 60
    },
    "autoApproveRules": {
      "type": "boolean"
    },
    "discovery": {
      "type": "object",
      "required": [],
      "properties": {
        "rootFolders": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "ignoredFolders": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config-settings"
}
