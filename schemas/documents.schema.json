{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "documents",
  "type": "object",
  "required": [
    "projectId",
    "kind",
    "markdown"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "pdd",
        "sdd",
        "runbook",
        "other"
      ]
    },
    "markdown": {
      "type": "string",
      "maxLength": 240000
    },
    "fileName": {
      "type": "string",
      "maxLength": 300
    },
    "source": {
      "type": "string",
      "enum": [
        "docx",
        "pdf",
        "md",
        "txt",
        "paste"
      ]
    },
    "chars": {
      "type": "integer",
      "minimum": 0
    },
    "masked": {
      "type": "integer",
      "minimum": 0
    },
    "uploadedBy": {
      "type": "string",
      "maxLength": 200
    },
    "uploadedAt": {
      "type": "string",
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "maxLength": 200
    }
  }
}
