{
  "type": "object",
  "required": [
    "projectId",
    "type",
    "at",
    "summary"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "enum": [
        "incident_resolved",
        "fix_required",
        "expected_behavior",
        "data_issue",
        "external_system",
        "false_positive",
        "recheck_scheduled",
        "recheck_done",
        "deploy_detected",
        "rule_added",
        "onboarding",
        "note"
      ]
    },
    "at": {
      "type": "string",
      "maxLength": 40
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "incidentId": {
      "type": "string",
      "maxLength": 200
    },
    "ruleId": {
      "type": "string",
      "maxLength": 200
    },
    "by": {
      "type": "string",
      "maxLength": 200
    },
    "ticket": {
      "type": "string",
      "maxLength": 200
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "history"
}