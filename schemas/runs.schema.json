{
  "type": "object",
  "required": [
    "startedAt",
    "status",
    "trigger"
  ],
  "properties": {
    "startedAt": {
      "type": "string",
      "maxLength": 40
    },
    "finishedAt": {
      "type": "string",
      "maxLength": 40
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "ok",
        "partial",
        "error"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "scheduled",
        "manual",
        "onboarding",
        "dry_run"
      ]
    },
    "sessionUrl": {
      "type": "string",
      "maxLength": 300
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "projectId",
          "status"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "skipped"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 200
          },
          "incidentsNew": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 200
          },
          "incidentsUpdated": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 200
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "maxItems": 50
          }
        }
      },
      "maxItems": 100
    },
    "summary": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runs"
}