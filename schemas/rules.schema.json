{
  "type": "object",
  "required": [
    "projectId",
    "text",
    "status",
    "origin"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "exceptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "by": {
            "type": "string",
            "maxLength": 200
          },
          "at": {
            "type": "string",
            "maxLength": 40
          },
          "incidentId": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_compile",
        "proposed",
        "active",
        "disabled",
        "rejected"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "manual",
        "onboarding",
        "learned",
        "similar",
        "review"
      ]
    },
    "sourceIncidentId": {
      "type": "string",
      "maxLength": 200
    },
    "compiled": {
      "type": "object"
    },
    "compileNote": {
      "type": "string",
      "maxLength": 2000
    },
    "createdBy": {
      "type": "string",
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "maxLength": 40
    },
    "approvedBy": {
      "type": "string",
      "maxLength": 200
    },
    "approvedAt": {
      "type": "string",
      "maxLength": 40
    },
    "updatedBy": {
      "type": "string",
      "maxLength": 200
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 40
    },
    "lastTriggeredAt": {
      "type": "string",
      "maxLength": 40
    },
    "sourceRuleId": {
      "type": "string",
      "maxLength": 200
    },
    "proposalKey": {
      "type": "string",
      "maxLength": 400
    },
    "why": {
      "type": "string",
      "maxLength": 1000
    },
    "suggestion": {
      "type": "object",
      "required": [
        "kind",
        "why"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exception",
            "severity",
            "text",
            "retire"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 2000
        },
        "why": {
          "type": "string",
          "maxLength": 1000
        },
        "key": {
          "type": "string",
          "maxLength": 400
        },
        "at": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "dismissedSuggestions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "at"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "at": {
            "type": "string",
            "maxLength": 40
          },
          "by": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rules"
}
