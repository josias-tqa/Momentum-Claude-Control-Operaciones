{
  "_nota": "Patrones de redacción aplicados a todo texto que venga de Orchestrator (logs, motivos de excepción) ANTES de escribir en el tablero. El orden importa: los más específicos primero. Agregar patrones propios de Momentum aquí.",
  "patrones": [
    {
      "nombre": "nombre_etiquetado",
      "regex": "\\b((?:[Pp]aciente|PACIENTE|[Aa]filiad[oa]|AFILIAD[OA]|[Bb]eneficiari[oa]|BENEFICIARI[OA]|[Tt]itular|TITULAR|[Nn]ombre|NOMBRE|[Cc]liente|CLIENTE))(\\s*[:=]\\s*|\\s+)([A-ZÁÉÍÓÚÑ][a-záéíóúñ]+(?:\\s+(?:de\\s+|del\\s+)?[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+){1,4})",
      "reemplazo": "$1$2[NOMBRE]"
    },
    {
      "nombre": "documento_etiquetado",
      "regex": "\\b(c\\.?\\s?c\\.?|t\\.?\\s?i\\.?|c[eé]dula|d\\.?n\\.?i\\.?|documento|identificaci[oó]n|n[uú]mero de id|nro\\.? doc\\.?|pasaporte)(\\s*(?:no\\.?|n[°º]|#)?\\s*[:=]?\\s*)[A-Z]{0,2}\\d[\\d.\\-]{4,14}",
      "flags": "gi",
      "reemplazo": "$1$2[DOCUMENTO]"
    },
    {
      "nombre": "nit",
      "regex": "\\b\\d{3}\\.?\\d{3}\\.?\\d{3}-\\d\\b",
      "reemplazo": "[ID-FISCAL]"
    },
    {
      "nombre": "email",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "reemplazo": "[EMAIL]"
    },
    {
      "nombre": "url_con_parametros",
      "regex": "(https?://[^\\s?#]+)\\?[^\\s]*",
      "reemplazo": "$1?[PARAMS]"
    },
    {
      "nombre": "iban",
      "regex": "\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]{4}){3,7}\\b",
      "reemplazo": "[CUENTA]"
    },
    {
      "nombre": "tarjeta",
      "regex": "\\b(?:\\d[ -]?){13,19}\\b",
      "reemplazo": "[TARJETA]"
    },
    {
      "nombre": "cuit_cuil",
      "regex": "\\b\\d{2}-?\\d{8}-?\\d\\b",
      "reemplazo": "[ID-FISCAL]"
    },
    {
      "nombre": "dni_documento",
      "regex": "\\b\\d{1,2}\\.?\\d{3}\\.?\\d{3}\\b",
      "reemplazo": "[DOCUMENTO]"
    },
    {
      "nombre": "telefono",
      "regex": "\\+?\\d{1,3}[ .-]?\\(?\\d{2,4}\\)?[ .-]?\\d{3,4}[ .-]?\\d{3,4}\\b",
      "reemplazo": "[TELEFONO]"
    },
    {
      "nombre": "ruta_usuario",
      "regex": "([Cc]:\\\\[Uu]sers\\\\)[^\\\\\\s]+",
      "reemplazo": "$1[USUARIO]"
    },
    {
      "nombre": "usuario_windows",
      "regex": "\\b[A-Z][A-Z0-9-]{1,14}\\\\[A-Za-z0-9._-]{2,30}\\b",
      "reemplazo": "[USUARIO]"
    },
    {
      "nombre": "ip",
      "regex": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "reemplazo": "[IP]"
    },
    {
      "nombre": "numero_largo",
      "regex": "\\b\\d{8,}\\b",
      "reemplazo": "[NUM]"
    }
  ]
}
